APP_NAME=Pharmacy Operations Workspace
DATABASE_URL=sqlite:///./pharmacy.db
BUSINESS_TIMEZONE=Africa/Cairo
ENVIRONMENT=development
COOKIE_SECURE=false

# Hosted Gemini chat provider. Obtain a key from https://aistudio.google.com/app/apikey
# Keep the key private and never commit it; a blank key disables AI chat.
GEMINI_API_KEY=
CHAT_MODEL_ID=gemini-3.8-flash
CHAT_MAX_OUTPUT_TOKENS=1800

# Local experimental language model. Weights download from Hugging Face on first use.
LLM_MODEL_ID=BioMistral/BioMistral-7B
LLM_MAX_NEW_TOKENS=160
LLM_CONTEXT_WINDOW=2048
